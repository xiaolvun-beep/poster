<view class="page">
  <view class="eyebrow">每一次工作</view><view class="title">记录</view>
  <view class="filter row"><picker mode="date" value="{{date}}" bindchange="chooseDate"><view class="date-button">{{date || '按日期查看'}}⌄</view></picker><text wx:if="{{date}}" class="clear" bindtap="clearDate">清除</text></view>
  <view wx:if="{{items.length}}" class="delete-hint">长按记录可删除</view>
  <view wx:if="{{items.length === 0}}" class="empty">{{loading ? '正在读取记录…' : '还没有符合条件的工作记录'}}</view>
  <view wx:for="{{items}}" wx:key="id" class="record card" data-id="{{item.id}}" bindtap="open" catchlongpress="confirmDelete">
    <view class="row"><view><view class="record-date">{{item.day}} <text class="record-time">{{item.time}}</text></view><view class="record-boss">{{item.bossName}} · {{item.duration}}</view></view><view class="record-amount amount">¥{{item.amount}}</view></view>
    <view class="record-status">{{item.status}}</view>
  </view>
</view>
