.detail-page { min-height: 100vh; padding: 32rpx 32rpx 60rpx; color: #1B2C20; background: #F3F6F1; }
.detail-heading { display: flex; flex-direction: column; margin: 4rpx 0 27rpx; }
.detail-overline { color: #7F9D7C; font-size: 20rpx; font-weight: 750; letter-spacing: 3rpx; }
.detail-title { margin-top: 11rpx; font-size: 49rpx; font-weight: 760; letter-spacing: -1rpx; }
.summary-card { padding: 33rpx 32rpx 30rpx; color: #F7FFF1; background: linear-gradient(135deg, #1C3425, #14241B 72%); border-radius: 32rpx; box-shadow: 0 18rpx 42rpx rgba(19, 47, 28, .14); }
.summary-top { display: flex; align-items: center; justify-content: space-between; color: #ACC1AA; font-size: 23rpx; }
.summary-status { padding: 9rpx 17rpx; border-radius: 22rpx; color: #E1F8B3; background: #3B573A; font-size: 21rpx; font-weight: 650; }
.summary-status.is-settled { color: #D4E4D2; background: #3B5140; }
.summary-amount { margin-top: 17rpx; color: #B7FF39; font-size: 78rpx; line-height: 1.18; font-weight: 760; letter-spacing: -3rpx; }
.summary-boss { display: flex; align-items: center; gap: 11rpx; margin-top: 17rpx; color: #B8CDB4; font-size: 24rpx; }
.summary-boss-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #B7FF39; }
.summary-rule { height: 1rpx; margin: 29rpx 0 25rpx; background: #36513C; }
.summary-stats { display: flex; gap: 32rpx; }
.summary-stat { display: flex; flex-direction: column; flex: 1; min-width: 0; }
.summary-stat-label { color: #96AB96; font-size: 21rpx; }
.summary-stat-value { margin-top: 8rpx; color: #F2FAEC; font-size: 32rpx; font-weight: 700; white-space: nowrap; }
.summary-stat-separator { width: 1rpx; background: #36513C; }
.track-card { margin-top: 24rpx; padding: 26rpx; background: #FFFFFF; border: 1rpx solid #E6EDE3; border-radius: 31rpx; box-shadow: 0 12rpx 32rpx rgba(36, 67, 42, .045); }
.track-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.track-overline { color: #8CA58B; font-size: 18rpx; font-weight: 750; letter-spacing: 2rpx; }
.track-title { margin-top: 5rpx; font-size: 33rpx; font-weight: 750; }
.track-hint { margin-top: 5rpx; color: #89998A; font-size: 20rpx; }
.track-symbol { display: flex; align-items: center; justify-content: center; width: 57rpx; height: 57rpx; border-radius: 18rpx; color: #FFFFFF; background: #2D7FF9; font-size: 32rpx; }
.detail-map { height: 440rpx; }
.track-legend { display: flex; align-items: center; gap: 24rpx; margin-top: 22rpx; color: #596F5C; font-size: 21rpx; }
.legend-item { display: flex; align-items: center; gap: 9rpx; white-space: nowrap; }
.legend-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.legend-start { background: #22C55E; border: 2rpx solid #FFFFFF; }
.legend-end { background: #EF4444; border: 2rpx solid #FFFFFF; }
.legend-line { flex: 1; height: 1rpx; background: #E3EBE2; }
.legend-route { color: #89998A; white-space: nowrap; }
.track-note { margin-top: 17rpx; padding-top: 16rpx; border-top: 1rpx solid #E8EFE6; color: #879887; font-size: 21rpx; line-height: 1.5; }
.info-heading { display: flex; justify-content: space-between; align-items: baseline; margin: 38rpx 2rpx 19rpx; }
.info-heading text:first-child { font-size: 30rpx; font-weight: 730; }
.info-heading text:last-child { color: #A1AFA0; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.info-card { padding: 6rpx 27rpx; background: #FFFFFF; border: 1rpx solid #E6EDE3; border-radius: 27rpx; }
.info-row { display: flex; justify-content: space-between; align-items: center; gap: 18rpx; min-height: 82rpx; border-bottom: 1rpx solid #EDF1EA; font-size: 24rpx; }
.info-row:last-child { border-bottom: 0; }
.info-row text:first-child { color: #879587; white-space: nowrap; }
.info-row text:last-child { text-align: right; color: #243526; font-weight: 600; }
.settle-one { display: flex; justify-content: space-between; width: 100%; height: 92rpx; margin-top: 24rpx; padding: 0 31rpx; color: #1B2D20; background: #B7FF39; border-radius: 21rpx; font-size: 25rpx; font-weight: 700; transition: transform .18s, opacity .18s; }
.settle-one text { font-size: 31rpx; font-weight: 400; }
.settle-one:active { transform: scale(.985); opacity: .88; }
